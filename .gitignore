# ── 비밀 정보 (가장 중요: 절대 커밋 금지) ──────────────
# 실제 키가 들어가는 파일입니다. .env.example 은 자리표시자만 있으므로 예외로 허용합니다.
.env
.env.*
!.env.example

# Cloudflare / Wrangler 로컬 상태 및 인증 정보
.wrangler/
.dev.vars
.dev.vars.*

# ── 의존성 ────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── 빌드 산출물 ───────────────────────────────────────
# 주의: 최상위 build/ 와 scripts/ 는 소스 코드이므로 제외하지 않습니다.
.next/
dist/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ── 로그 및 캐시 ──────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
.eslintcache
coverage/

# ── 에디터 / 운영체제 ─────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── Supabase CLI 로컬 상태 ────────────────────────────
# 이 컴퓨터에만 해당하는 연결 정보(DB 접속 URL 포함)라 커밋하지 않는다.
supabase/.temp/
supabase/.branches/

# ── Vercel CLI 가 자동 추가한 규칙 ────────────────────
.vercel
.env*

# 위 .env* 규칙이 .env.example 까지 제외하므로 예외를 다시 지정한다.
# 주의: Vercel CLI 가 실행될 때마다 파일 끝에 .env* 를 다시 덧붙인다.
# 그러면 이 예외가 무효화되므로, 아래 줄은 항상 파일 맨 끝에 있어야 한다.
!.env.example
