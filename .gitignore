# ── 비밀 정보 (가장 중요: 절대 커밋 금지) ──────────────
# 실제 키가 들어가는 파일입니다. .env.example 은 자리표시자만 있으므로 예외로 허용합니다.
.env
.env.*
!.env.example

# Cloudflare / Wrangler 로컬 상태 및 인증 정보
.wrangler/
.dev.vars
.dev.vars.*

# ── 의존성 ────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── 빌드 산출물 ───────────────────────────────────────
# 주의: 최상위 build/ 와 scripts/ 는 소스 코드이므로 제외하지 않습니다.
.next/
dist/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ── 로그 및 캐시 ──────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
.eslintcache
coverage/

# ── 에디터 / 운영체제 ─────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
